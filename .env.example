VITE_APP_API_URL=https://localhost:8080/api

# Optional. When unset, the Edit Profile button on the account page is hidden.
# VITE_IDP_ACCT_CONSOLE=

# Keycloak realm base URL and client ID, used to build the sign-out redirect
# to Keycloak's end-session endpoint (kills the SSO session, not just this
# app's token). Both must be set together; when either is unset, sign-out
# falls back to clearing the local session only. The post-logout landing page
# (this app's origin + /welcome) must be registered in Keycloak under
# Clients -> locationlens -> Valid post logout redirect URIs.
# VITE_IDP_URI=http://localhost:8084/realms/locationlens
# VITE_IDP_CLIENT_ID=locationlens

# Browser key for the Google Maps JavaScript API (not the backend Places key).
# VITE_GOOGLE_MAPS_API_KEY=
# Optional in development; DEMO_MAP_ID is used when unset. Set your map ID for deployment.
# VITE_GOOGLE_MAPS_MAP_ID=
